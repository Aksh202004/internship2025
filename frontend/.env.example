# Supabase Configuration
# Using Cloudflare Worker proxy to bypass ISP blocks
REACT_APP_SUPABASE_URL=your_supabase_proxy_url_or_direct_url
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key
# Original Supabase URL (for reference/storage)
REACT_APP_SUPABASE_DIRECT_URL=your_supabase_direct_url

# Clerk Authentication
REACT_APP_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Admin Access Control (comma-separated emails)
REACT_APP_ADMIN_EMAILS=admin@example.com
